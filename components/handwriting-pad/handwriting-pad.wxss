.pad-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  background: rgba(20, 16, 30, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}
.pad-panel {
  width: 100%;
  height: 80vh;
  background: var(--card, #fff);
  border-radius: 28rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}
.pad-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.pad-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text, #333);
}
.pad-header-actions {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.pad-switch {
  font-size: var(--fs-sm);
  font-weight: 600;
  color: var(--primary, #7B5EA7);
  background: #F5F0FF;
  padding: 8rpx 20rpx;
  border-radius: 22rpx;
}
.pad-close {
  font-size: var(--fs-sm);
  color: var(--text-light, #999);
}
.pad-body {
  position: relative;
  flex: 1;
  min-height: 0;
  display: flex;
}
.pad-main {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
}
/* 题目查看层：覆盖在手写区上方 */
.pad-peek {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 2;
  background: #fff;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
}
.pad-peek-scroll {
  flex: 1;
  min-height: 0;
  box-sizing: border-box;
  padding: 8rpx 4rpx;
}
.pad-peek-back {
  margin-top: 16rpx;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  background: #F5F0FF;
  color: var(--primary, #7B5EA7);
}
.pad-tip {
  font-size: var(--fs-sm);
  color: var(--text-light, #999);
  margin-top: 8rpx;
}
.pad-canvas-wrap {
  flex: 1;
  margin: 16rpx 0;
  border: 1rpx dashed #CBBFE0;
  border-radius: 16rpx;
  overflow: hidden;
  background: #fff;
}
.pad-canvas {
  width: 100%;
  height: 100%;
}
.pad-actions {
  display: flex;
  gap: 20rpx;
}
.pad-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}
.pad-btn.ghost {
  background: #F5F0FF;
  color: #7B5EA7;
}
.pad-btn.primary {
  background: linear-gradient(135deg, #7B5EA7, #9B7FC7);
  color: #fff;
  font-weight: 600;
}
