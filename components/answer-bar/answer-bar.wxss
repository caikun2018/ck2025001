/* 答题输入栏：白底 + 紫色系，和 AI 助手底部输入栏同一套视觉 */
.answer-bar {
  flex-shrink: 0;
  width: 100%;
  box-sizing: border-box;
  padding: 16rpx 20rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(123, 94, 167, 0.1);
}

/* 语音回显 */
.echo {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  padding: 4rpx 8rpx 14rpx;
  font-size: var(--fs-sm, 26rpx);
  line-height: 1.5;
}
.echo-label {
  color: #A99BC0;
  flex-shrink: 0;
}
.echo-text {
  color: #999;
}
.echo.has .echo-text {
  color: #333;
  font-size: var(--fs, 28rpx);
  font-weight: 600;
}

.bar {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

/* 左侧语音/键盘切换 */
.mode-btn {
  flex-shrink: 0;
  height: 80rpx;
  padding: 0 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs, 28rpx);
  font-weight: 600;
  color: #7B5EA7;
  background: #fff;
  border: 1rpx solid #D9C7F5;
  border-radius: 20rpx;
}
.mode-btn.disabled {
  opacity: 0.5;
}

/* 中间：按住说话 / 键盘输入 */
.voice-btn {
  flex: 1;
  height: 92rpx;
  background: #F5F0FF;
  border-radius: 46rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: calc(var(--fs, 28rpx) * 1.1);
  color: #7B5EA7;
  font-weight: 600;
  letter-spacing: 2rpx;
}
.voice-btn.recording {
  background: #FF6B9D;
  color: #fff;
}
.voice-btn.disabled {
  opacity: 0.65;
}
.bar-input {
  flex: 1;
  height: 80rpx;
  background: #F5F0FF;
  border-radius: 40rpx;
  padding: 0 28rpx;
  font-size: var(--fs, 28rpx);
}

/* 右侧：提交 */
.send-btn {
  flex-shrink: 0;
  padding: 16rpx 30rpx;
  background: linear-gradient(135deg, #7B5EA7, #9B7FC7);
  color: #fff;
  border-radius: 40rpx;
  font-size: var(--fs, 28rpx);
  font-weight: 600;
}
.send-btn.disabled {
  opacity: 0.5;
}

/* ===== 录音悬浮提示：按住说话时浮在屏幕中间 ===== */
.rec-mask {
  position: fixed;
  left: 50%;
  top: 42%;
  transform: translate(-50%, -50%);
  z-index: 999;
  width: 420rpx;
  box-sizing: border-box;
  padding: 34rpx 28rpx 28rpx;
  background: rgba(90, 66, 130, 0.94);
  border-radius: 32rpx;
  box-shadow: 0 16rpx 48rpx rgba(60, 36, 96, 0.35);
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 麦克风：三个 view 拼出来，不用图片素材 */
.rec-card {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.rec-mic {
  position: relative;
  width: 130rpx;
  height: 130rpx;
}
.rec-halo {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 100rpx;
  height: 100rpx;
  margin: -50rpx 0 0 -50rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
  animation: recHalo 1.8s ease-out infinite;
}
.rec-halo.late {
  animation-delay: 0.9s;
}
.rec-head {
  position: absolute;
  left: 50rpx;
  top: 26rpx;
  width: 30rpx;
  height: 44rpx;
  border-radius: 15rpx;
  background: #fff;
}
.rec-arc {
  position: absolute;
  left: 35rpx;
  top: 44rpx;
  width: 60rpx;
  height: 32rpx;
  box-sizing: border-box;
  border: 6rpx solid #fff;
  border-top: none;
  border-radius: 0 0 32rpx 32rpx;
}
.rec-stem {
  position: absolute;
  left: 62rpx;
  top: 76rpx;
  width: 6rpx;
  height: 16rpx;
  background: #fff;
}
.rec-base {
  position: absolute;
  left: 48rpx;
  top: 92rpx;
  width: 34rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: #fff;
}

/* 音量音柱：高低跳动，表示正在收音 */
.rec-wave {
  display: flex;
  align-items: flex-end;
  gap: 10rpx;
  height: 44rpx;
  margin-top: 6rpx;
}
.rec-bar {
  width: 10rpx;
  height: 44rpx;
  border-radius: 5rpx;
  background: #fff;
  transform-origin: bottom;
  animation: recWave 0.9s ease-in-out infinite;
}
.rec-bar.b2 {
  animation-delay: 0.15s;
}
.rec-bar.b3 {
  animation-delay: 0.3s;
}
.rec-bar.b4 {
  animation-delay: 0.45s;
}
.rec-bar.b5 {
  animation-delay: 0.6s;
}

.rec-tip {
  margin-top: 16rpx;
  font-size: var(--fs, 28rpx);
  font-weight: 600;
  color: #fff;
}
.rec-sub {
  margin-top: 6rpx;
  font-size: var(--fs-sm, 26rpx);
  color: rgba(255, 255, 255, 0.72);
}

@keyframes recHalo {
  0% {
    transform: scale(0.7);
    opacity: 0.75;
  }
  100% {
    transform: scale(1.5);
    opacity: 0;
  }
}
@keyframes recWave {
  0%,
  100% {
    transform: scaleY(0.3);
    opacity: 0.6;
  }
  50% {
    transform: scaleY(1);
    opacity: 1;
  }
}
