.settle-page {
  position: relative;
  min-height: 100vh;
  background: linear-gradient(180deg, #E8DCFF 0%, #F5F0FF 100%);
}

.settle-content {
  position: relative;
  z-index: 10;
  padding: 80rpx 32rpx 60rpx;
  text-align: center;
}

.settle-char {
  width: 220rpx;
  height: 220rpx;
  margin: 0 auto;
  animation: settleFloat 2s ease-in-out infinite;
}
@keyframes settleFloat {
  0%, 100% { transform: translateY(0) scale(1); }
  50% { transform: translateY(-16rpx) scale(1.05); }
}

.settle-stars {
  margin: 32rpx 0;
}
.big-star {
  font-size: 80rpx;
  color: #ddd;
  margin: 0 12rpx;
  transition: all 0.3s;
}
.big-star.on {
  color: #FFD93D;
  text-shadow: 0 0 20rpx rgba(255,217,61,0.8);
  animation: starPop 0.5s ease;
}
@keyframes starPop {
  0% { transform: scale(0); }
  60% { transform: scale(1.3); }
  100% { transform: scale(1); }
}

.settle-comment {
  font-size: 36rpx;
  font-weight: 700;
  color: #7B5EA7;
  margin-bottom: 40rpx;
}

.score-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(123,94,167,0.12);
  margin-bottom: 40rpx;
}
.score-item {
  flex: 1;
  text-align: center;
}
.score-num {
  font-size: 56rpx;
  font-weight: 700;
  color: #333;
}
.score-label {
  display: block;
  font-size: var(--fs-sm);
  color: #999;
  margin-top: 8rpx;
}
.score-divider {
  width: 2rpx;
  height: 80rpx;
  background: #f0f0f0;
}

.wrong-confirm {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(123,94,167,0.12);
  margin-bottom: 32rpx;
  text-align: left;
}
.wrong-confirm-title {
  font-size: 28rpx;
  color: #FF6B6B;
  font-weight: 600;
  margin-bottom: 20rpx;
}
.wrong-list-mini {
  max-height: 300rpx;
  overflow-y: auto;
}
.wrong-item-mini {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
  font-size: var(--fs-sm);
  color: #666;
}
.wrong-q-mini {
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.confirm-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}
.confirm-btn {
  flex: 1;
  font-size: 28rpx;
}

.no-wrong {
  padding: 40rpx 0;
}
.no-wrong-text {
  font-size: 30rpx;
  color: #6BCB77;
  font-weight: 600;
}

.back-btn {
  margin-top: 32rpx;
}
