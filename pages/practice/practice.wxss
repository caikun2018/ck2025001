.practice-page {
  min-height: 100vh;
  /* 给底部「开始练习」按钮留位，最后一条错题不会被挡住 */
  padding-bottom: 260rpx;
}

/* ===== 自定义标题栏（navigationStyle: custom） ===== */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 60;
  background: #FFFFFF;
  border-bottom: 1rpx solid #EEE6FA;
}
.nav-inner {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}
/* 标题栏左侧：科目下拉框（原学科栏） */
.nav-picker {
  position: absolute;
  left: 20rpx;
  top: 50%;
  transform: translateY(-50%);
}
.nav-subject {
  display: flex;
  align-items: center;
  height: 56rpx;
  padding: 0 22rpx;
  border-radius: 28rpx;
  background: #F0E8FF;
  color: var(--primary, #7B5EA7);
  font-size: var(--fs-sm);
  font-weight: 600;
  line-height: 1;
}
.nav-subject-text {
  max-width: 180rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.nav-subject-arrow {
  margin-left: 8rpx;
  opacity: 0.85;
}
.nav-title {
  font-size: calc(var(--fs, 28rpx) * 1.3);
  font-weight: 600;
  color: var(--text, #333333);
}

.mode-tabs {
  display: flex;
  background: #fff;
  padding: 20rpx 24rpx;
  gap: 20rpx;
}
.mode-tab {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 24rpx;
  /* 跟随全局字号放大，默认 28rpx × 1.25 ≈ 35rpx */
  font-size: calc(var(--fs) * 1.25);
  color: #999;
  background: #F5F0FF;
}
.mode-tab.active {
  background: linear-gradient(135deg, #7B5EA7, #9B7FC7);
  color: #fff;
  font-weight: 600;
}

.filter-bar {
  padding: 16rpx 24rpx;
}
/* 搜索框（沿用原错题本） */
.search-inline {
  background: var(--card, #fff);
  border-radius: 999rpx;
  padding: 0 28rpx;
  box-shadow: 0 4rpx 14rpx rgba(123, 94, 167, 0.1);
}
.search-inline-input {
  height: 72rpx;
  font-size: var(--fs-sm);
  color: var(--text, #333);
}

.select-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 32rpx;
  font-size: var(--fs-sm);
  color: #7B5EA7;
}
.select-tip {
  flex: 1;
  font-size: var(--fs-sm);
  color: #8A7BA8;
}
.select-actions {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.select-all {
  font-size: var(--fs-sm);
  color: #FF6B9D;
}

.practice-list {
  padding: 0 24rpx;
}
.practice-item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(123,94,167,0.06);
}
.practice-item.sel {
  border: 2rpx solid #7B5EA7;
  background: #F8F5FF;
}
.check-box {
  position: relative;
  width: 44rpx;
  height: 44rpx;
  border: 3rpx solid #ccc;
  border-radius: 50%;
  margin-right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-sm);
  color: #fff;
  flex-shrink: 0;
}
/* 透明热区：圆圈本身 44rpx，可点范围扩到 80rpx（别删，不然又要点很多次） */
.check-box::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 80rpx;
  height: 80rpx;
  transform: translate(-50%, -50%);
  border-radius: 50%;
}
.practice-item.sel .check-box {
  background: #7B5EA7;
  border-color: #7B5EA7;
}
.practice-info {
  flex: 1;
  min-width: 0;
}
.practice-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 8rpx;
}
/* 题干：点它进错题详情 */
.practice-question {
  font-size: var(--fs-sm);
  color: #777;
  line-height: 1.5;
  margin-bottom: 10rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.practice-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.diff-tag {
  font-size: var(--fs-sm);
  color: #999;
}
.fade-mini {
  font-size: var(--fs-sm);
  color: #7B5EA7;
}
.detail-arrow {
  flex-shrink: 0;
  font-size: 40rpx;
  color: #C9B6E4;
  padding-left: 12rpx;
}

.bottom-bar {
  position: fixed;
  bottom: 120rpx;
  left: 24rpx;
  right: 24rpx;
  z-index: 50;
}

.exam-card {
  margin: 24rpx;
  background: #fff;
  border-radius: 32rpx;
  padding: 48rpx 32rpx;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(123,94,167,0.12);
}
.exam-char {
  width: 160rpx;
  height: 160rpx;
  margin: 0 auto 24rpx;
}
.exam-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #7B5EA7;
}
.exam-desc {
  font-size: var(--fs-sm);
  color: #999;
  margin: 12rpx 0 40rpx;
}
.exam-form {
  text-align: left;
  margin-bottom: 40rpx;
}
.exam-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.exam-label {
  width: 180rpx;
  font-size: 28rpx;
  color: #666;
}
.exam-picker {
  flex: 1;
}
.exam-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 28rpx;
  color: #7B5EA7;
  font-weight: 600;
}
.exam-value-arrow {
  font-size: var(--fs-sm);
  opacity: 0.8;
  margin-left: 8rpx;
}
.exam-row slider { flex: 1; }
.exam-start {
  width: 100%;
}
