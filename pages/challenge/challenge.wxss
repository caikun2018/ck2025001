.challenge-page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.challenge-header {
  background: linear-gradient(135deg, #FFA552, #FF6B9D);
  padding: 48rpx 32rpx 40rpx;
  color: #fff;
  border-radius: 0 0 40rpx 40rpx;
}
.challenge-header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.challenge-title-wrap {
  flex: 1;
  min-width: 0;
}
.challenge-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
}
.challenge-sub {
  display: block;
  font-size: var(--fs-sm);
  opacity: 0.9;
  margin-top: 8rpx;
}

/* 学科下拉框（与乐享知识库科目对应，含全科） */
.subject-picker {
  flex-shrink: 0;
  margin-left: 20rpx;
}
.subject-picker-box {
  display: flex;
  align-items: center;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.24);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
}
.subject-picker-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
}
.subject-picker-arrow {
  font-size: var(--fs-sm);
  color: #fff;
  margin-left: 8rpx;
  opacity: 0.9;
}

.quick-start {
  display: flex;
  align-items: center;
  margin: 24rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(123,94,167,0.08);
}
.quick-char {
  width: 100rpx;
  height: 100rpx;
  margin-right: 20rpx;
}
.quick-info { flex: 1; }
.quick-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}
.quick-sub {
  font-size: var(--fs-sm);
  color: #999;
  margin-top: 4rpx;
}
.quick-arrow {
  color: #7B5EA7;
  font-size: 28rpx;
}

.level-map {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  padding: 0 24rpx;
}
.level-node {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx 20rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(123,94,167,0.08);
  position: relative;
  overflow: hidden;
}
.level-num {
  width: 60rpx;
  height: 60rpx;
  line-height: 60rpx;
  background: linear-gradient(135deg, #FFD93D, #FFA552);
  color: #fff;
  border-radius: 50%;
  font-size: 28rpx;
  font-weight: 700;
  margin: 0 auto 12rpx;
}
.level-name {
  font-size: var(--fs-sm);
  color: #333;
  font-weight: 600;
}
.level-scope {
  font-size: var(--fs-sm);
  color: #999;
  margin-top: 6rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.level-stars {
  margin-top: 8rpx;
}
.star {
  font-size: 28rpx;
  color: #ddd;
}
.star.on {
  color: #FFD93D;
}
