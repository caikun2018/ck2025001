.result-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #E8DCFF, #F5F0FF);
  padding: 80rpx 32rpx;
  text-align: center;
}

.result-char {
  width: 200rpx;
  height: 200rpx;
  margin: 0 auto 32rpx;
}
.result-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #7B5EA7;
  margin-bottom: 48rpx;
}

.result-score {
  margin-bottom: 32rpx;
}
.score-big {
  font-size: 96rpx;
  font-weight: 800;
}
.score-sub {
  display: block;
  font-size: var(--fs-sm);
  color: #999;
  margin-top: 8rpx;
}

.rate-bar {
  height: 24rpx;
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}
.rate-fill {
  height: 100%;
  background: linear-gradient(90deg, #FF6B9D, #FFD93D, #6BCB77);
  border-radius: 12rpx;
  transition: width 0.8s;
}
.rate-text {
  font-size: 28rpx;
  color: #7B5EA7;
  font-weight: 600;
  margin-bottom: 48rpx;
}

.wrong-section {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(123,94,167,0.12);
}
.wrong-title {
  font-size: 28rpx;
  color: #FF6B6B;
  font-weight: 600;
  margin-bottom: 24rpx;
}
.wrong-actions {
  display: flex;
  gap: 20rpx;
}
.wrong-actions button { flex: 1; font-size: 28rpx; }

.back-btn {
  margin-top: 40rpx;
}
