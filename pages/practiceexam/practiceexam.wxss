/* 模拟考试 / 原题练习：整页竖向三段式 —— 顶栏 / 题目 / 底部答案区 */
.exam-page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  box-sizing: border-box;
  background: var(--bg, #F5F0FF);
}

/* ===== 顶部栏：左计时（或标题），右手写板 ===== */
.exam-topbar {
  position: sticky;
  top: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  background: var(--card, #fff);
  border-bottom: 1rpx solid rgba(123, 94, 167, 0.08);
}
.timer-box {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.timer-icon {
  font-size: var(--fs-sm);
}
.timer-text {
  font-size: calc(var(--fs) * 1.1);
  font-weight: 700;
  color: #FF6B6B;
  font-variant-numeric: tabular-nums;
  letter-spacing: 1rpx;
}
.topbar-title {
  font-size: var(--fs);
  font-weight: 600;
  color: var(--primary, #7B5EA7);
}
.top-action {
  flex-shrink: 0;
  padding: 12rpx 26rpx;
  border-radius: 32rpx;
  font-size: var(--fs-sm);
  font-weight: 600;
  white-space: nowrap;
}
.pad-entry {
  background: var(--card, #fff);
  color: var(--primary, #7B5EA7);
  border: 1rpx solid rgba(123, 94, 167, 0.18);
  box-shadow: 0 4rpx 16rpx rgba(123, 94, 167, 0.18);
}

/* ===== 进度条 ===== */
.exam-progress {
  padding: 20rpx 24rpx 0;
}
.progress-info {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 12rpx;
  font-size: var(--fs-sm);
  font-weight: 600;
  color: var(--primary, #7B5EA7);
}
.progress-tip {
  color: #A99BC0;
  font-weight: 400;
}
.progress-line {
  height: 12rpx;
  border-radius: 6rpx;
  background: #EDE5FB;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  border-radius: 6rpx;
  background: linear-gradient(90deg, #FF6B9D, #FFD93D, #6BCB77);
  transition: width 0.3s;
}

/* ===== 题目区 ===== */
.exam-content {
  flex: 1;
  padding: 24rpx;
}
.question-card {
  background: var(--card, #fff);
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 6rpx 24rpx rgba(123, 94, 167, 0.1);
}
.question-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.q-subject {
  flex-shrink: 0;
  padding: 6rpx 20rpx;
  border-radius: 16rpx;
  background: #F0E8FF;
  color: var(--primary, #7B5EA7);
  font-size: var(--fs-sm);
  font-weight: 600;
}
.q-knowledge {
  max-width: 60%;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  background: #F8F5FF;
  color: #A99BC0;
  font-size: var(--fs-sm);
  text-align: right;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.q-text {
  font-size: calc(var(--fs) * 1.05);
  line-height: 1.7;
  color: var(--text, #333);
  font-weight: 500;
  word-break: break-word;
}
.q-options {
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: #F8F5FF;
}
.q-option {
  font-size: var(--fs);
  color: #555;
  line-height: 1.9;
}
.exam-empty {
  padding: 120rpx 40rpx;
  text-align: center;
  font-size: var(--fs-sm);
  color: #A99BC0;
}

/* ===== 底部：答案栏 + 翻页 ===== */
.exam-footer {
  margin-top: auto;
  padding: 8rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
}
.exam-nav {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}
.exam-nav-btn {
  flex: 1;
  min-width: 0;
  margin: 0;
  padding: 22rpx 0;
  border: none;
  border-radius: 44rpx;
  font-size: var(--fs);
  font-weight: 600;
  line-height: 1.3;
  text-align: center;
}
.exam-nav-btn::after {
  border: none;
}
.exam-nav-btn.prev {
  background: var(--card, #fff) !important;
  color: var(--primary, #7B5EA7) !important;
  border: 2rpx solid var(--primary, #7B5EA7);
}
.exam-nav-btn.next {
  background: linear-gradient(135deg, #7B5EA7, #9B7FC7) !important;
  color: #fff !important;
  box-shadow: 0 4rpx 16rpx rgba(123, 94, 167, 0.28);
}
.exam-nav-btn.submit {
  background: #FF6B6B !important;
  color: #fff !important;
}
.exam-nav-btn.is-disabled {
  opacity: 0.45;
}

/* ===== 判题结果（原题练习） ===== */
.result-feedback {
  margin-bottom: 20rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  text-align: center;
  font-size: var(--fs);
  font-weight: 600;
}
.result-feedback.right {
  background: #E8FFF0;
  color: #6BCB77;
}
.result-feedback.wrong {
  background: #FFE8E8;
  color: #FF6B6B;
}
.recognized {
  margin-bottom: 16rpx;
  padding: 14rpx 18rpx;
  border-radius: 12rpx;
  background: #FFF8E8;
  color: #8A6D3B;
  font-size: var(--fs-sm);
  line-height: 1.6;
}
.my-answer {
  margin-bottom: 16rpx;
  font-size: var(--fs-sm);
  color: var(--primary, #7B5EA7);
  word-break: break-all;
}
.answer-detail {
  margin-bottom: 24rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: var(--card, #fff);
  box-shadow: 0 4rpx 16rpx rgba(123, 94, 167, 0.1);
  font-size: var(--fs-sm);
  color: #333;
  line-height: 1.7;
}
.exp {
  margin-top: 12rpx;
  color: var(--primary, #7B5EA7);
}
.next-btn {
  width: 100%;
}

/* ===== 手写作答预览（原题练习） ===== */
.pad-preview {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
  padding: 16rpx 20rpx;
  border-radius: 20rpx;
  background: var(--card, #fff);
  box-shadow: 0 4rpx 16rpx rgba(123, 94, 167, 0.1);
}
.pad-preview-img {
  width: 160rpx;
  height: 100rpx;
  border-radius: 12rpx;
  background: #FAF7FF;
}
.pad-preview-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  font-size: var(--fs-sm);
  color: #666;
}
.pad-preview-remove {
  color: #FF6B6B;
  font-size: var(--fs-sm);
}
.answer-tip {
  margin-top: 12rpx;
  text-align: center;
  font-size: var(--fs-sm);
  color: #A99BC0;
}
.retry-hint {
  margin-bottom: 20rpx;
  padding: 18rpx 22rpx;
  border-radius: 16rpx;
  background: #FFE8E8;
  color: #FF6B6B;
  font-size: var(--fs-sm);
  font-weight: 600;
  line-height: 1.5;
}

/* ===== 手写板里的「看题目」视图 ===== */
.pad-question {
  padding: 8rpx 12rpx 20rpx;
}
