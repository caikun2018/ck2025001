.achievement-page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.overview-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #7B5EA7, #9B7FC7);
  margin: 24rpx;
  border-radius: 32rpx;
  padding: 40rpx 32rpx;
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(123,94,167,0.25);
}

.overview-ring {
  margin-right: 40rpx;
}
.ring-progress {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.ring-inner {
  width: 140rpx;
  height: 140rpx;
  background: #7B5EA7;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.ring-num {
  font-size: 44rpx;
  font-weight: 800;
}
.ring-label {
  font-size: var(--fs-sm);
  opacity: 0.9;
}

.overview-info { flex: 1; }
.overview-row {
  display: flex;
  align-items: baseline;
  margin-bottom: 16rpx;
}
.ov-num {
  font-size: 36rpx;
  font-weight: 700;
  margin-right: 12rpx;
}
.ov-label {
  font-size: var(--fs-sm);
  opacity: 0.85;
}

.badge-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  padding: 0 24rpx;
}
.badge-item {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx 20rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(123,94,167,0.08);
  position: relative;
}
.badge-item.locked {
  opacity: 0.5;
  filter: grayscale(0.8);
}
.badge-img {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 16rpx;
}
.badge-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}
.badge-desc {
  font-size: var(--fs-sm);
  color: #999;
  margin-top: 6rpx;
  line-height: 1.4;
}
.badge-status {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  font-size: var(--fs-sm);
  color: #bbb;
  background: #f5f5f5;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.tip {
  margin: 32rpx 24rpx 0;
  padding: 20rpx 24rpx;
  background: #FFF8E8;
  border-radius: 16rpx;
  font-size: var(--fs-sm);
  color: #B8860B;
  line-height: 1.5;
}
