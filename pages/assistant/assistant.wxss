.assistant-page {
  min-height: 100vh;
  background: var(--card, #FFFFFF);
}

/* ===== 自定义标题栏（navigationStyle: custom） ===== */
.nav-bar {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 10;
  background: #FFFFFF;
  border-bottom: 1rpx solid #EEE6FA;
}
.nav-inner {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}
/* 左上角「新建对话」：挪进标题栏，不再占对话区高度 */
.nav-new {
  position: absolute;
  left: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  height: 68rpx;
  padding: 0 26rpx;
  display: flex;
  align-items: center;
  border-radius: 34rpx;
  background: #F0E8FF;
  color: var(--primary, #7B5EA7);
  font-size: calc(var(--fs, 28rpx) * 1.15);
  font-weight: 600;
  line-height: 1;
}
.nav-title {
  font-size: calc(var(--fs, 28rpx) * 1.3);
  font-weight: 600;
  color: #333333;
}
