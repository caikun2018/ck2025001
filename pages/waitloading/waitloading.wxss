.wait-page {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
}

.wait-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.wait-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(123,94,167,0.2) 0%, rgba(255,255,255,0.1) 40%, rgba(123,94,167,0.15) 100%);
}

.wait-content {
  position: absolute;
  top: 180rpx;
  left: 0;
  right: 0;
  text-align: center;
  z-index: 10;
}
.wait-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #fff;
  text-shadow: 0 4rpx 12rpx rgba(123,94,167,0.5);
}
.wait-sub {
  font-size: 28rpx;
  color: #fff;
  margin-top: 12rpx;
  text-shadow: 0 2rpx 8rpx rgba(123,94,167,0.5);
}
