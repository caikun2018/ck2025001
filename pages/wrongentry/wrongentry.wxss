.entry-page {
  min-height: 100vh;
  padding: 24rpx;
}

.loading-state {
  text-align: center;
  padding: 120rpx 40rpx;
}
.loading-char {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 32rpx;
  animation: float 2s ease-in-out infinite;
}
@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-16rpx); }
}
.loading-text {
  font-size: 32rpx;
  color: #7B5EA7;
  font-weight: 600;
}
.loading-sub {
  font-size: var(--fs-sm);
  color: #999;
  margin-top: 12rpx;
  line-height: 1.7;
  padding: 0 40rpx;
}

.photo-preview {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.preview-img {
  width: 100%;
  border-radius: 16rpx;
}

.confirm-tip {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: linear-gradient(135deg, #FFF0E8, #FFE8F0);
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.tip-icon {
  width: 80rpx;
  height: 80rpx;
  flex-shrink: 0;
}
.tip-title {
  font-size: 28rpx;
  color: #7B5EA7;
  font-weight: 600;
}
.tip-sub {
  font-size: var(--fs-sm);
  color: #999;
  margin-top: 4rpx;
}

.form-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.form-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.form-row.col {
  flex-direction: column;
  align-items: stretch;
}
.form-label {
  width: 160rpx;
  font-size: var(--fs-sm);
  color: #7B5EA7;
  font-weight: 600;
  flex-shrink: 0;
}
.form-row.col .form-label {
  margin-bottom: 12rpx;
}
.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}
.form-picker {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}
.form-textarea {
  width: 100%;
  min-height: 120rpx;
  font-size: 28rpx;
  color: #333;
  background: #F8F5FF;
  border-radius: 12rpx;
  padding: 16rpx;
}

.entry-actions {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 0;
}
.entry-btn {
  flex: 1;
  font-size: 30rpx;
}
